{
  "name": "@pig-agents/electron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "sync-icon": "node scripts/sync-icon.mjs"
  },
  "dependencies": {
    "@pig-agents/core": "0.1.0",
    "dotenv": "16.4.7",
    "electron-store": "10.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "electron": "34.0.2",
    "electron-builder": "25.1.8",
    "typescript": "5.7.2"
  }
}
