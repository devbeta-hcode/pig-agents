{
  "name": "@pig-agents/electron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/electron-launch.mjs",
    "build": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "package:win": "electron-builder --win nsis --x64",
    "package:linux": "electron-builder --linux deb --x64"
  },
  "dependencies": {
    "@pig-agents/core": "1.0.0",
    "dotenv": "16.4.7",
    "electron-store": "10.0.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "electron": "34.0.2",
    "electron-builder": "25.1.8",
    "typescript": "5.7.2"
  },
  "build": {
    "appId": "com.devbeta.pig-agents-desktop",
    "productName": "Pig Agents",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "../renderer/dist/**/*",
      "../core/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "arch": [
        "x64"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "arch": [
        "x64"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "arch": [
        "x64",
        "arm64"
      ]
    }
  }
}
